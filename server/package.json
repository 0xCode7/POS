{
  "name": "@restaurant-pos/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('drizzle','dist/drizzle',{recursive:true})\"",
    "start": "cross-env NODE_ENV=production node --env-file-if-exists=../.env dist/index.js",
    "restore": "tsx --env-file-if-exists=../.env src/maintenance/restore-cli.ts",
    "supervisor": "npm run build && node --env-file-if-exists=../.env dist/maintenance/supervisor-cli.js",
    "sample-data": "tsx src/maintenance/sample-data.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "luxon": "^3.7.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.6",
    "@types/luxon": "^3.7.1",
    "@types/node": "26.6.5",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
