{
  "name": "@restaurant-pos/desktop",
  "version": "0.2.5",
  "description": "Offline Restaurant POS desktop application",
  "author": "Restaurant POS",
  "homepage": "https://github.com/0xCode7/POS",
  "desktopName": "com.efendina.restaurantpos",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../scripts/prepare-electron-runtime.mjs && node ../scripts/generate-electron-icons.mjs",
    "rebuild:native": "electron-builder install-app-deps",
    "dev": "cross-env POS_ELECTRON_DEV=1 node scripts/launch.mjs",
    "start": "node scripts/launch.mjs",
    "package:linux": "npm run rebuild:native && electron-builder --x64 --publish never",
    "package:win": "npm run rebuild:native && electron-builder --win nsis portable --x64 --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "luxon": "^3.7.2",
    "zod": "4.6.7"
  },
  "build": {
    "appId": "com.efendina.restaurantpos",
    "productName": "مطعم أفندينا",
    "executableName": "RestaurantPOS",
    "asar": false,
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "../release/electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json",
      "!dist/**/*.map"
    ],
    "extraMetadata": {
      "main": "dist/main.js"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "syncDesktopName": true,
      "icon": "build/icons",
      "maintainer": "Efendina Restaurant",
      "synopsis": "Offline single-restaurant point of sale",
      "description": "Offline Arabic-first Restaurant POS for one local counter/takeaway restaurant."
    },
    "appImage": {
      "artifactName": "RestaurantPOS-Linux-x64.${ext}"
    },
    "deb": {
      "packageName": "restaurant-pos",
      "artifactName": "RestaurantPOS-Linux-amd64.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "RestaurantPOS-win-${arch}-nsis.${ext}",
      "include": "build/installer.nsh",
      "guid": "5D39E18D-5FC2-4A76-8E89-3D864EC4A98D",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "مطعم أفندينا"
    },
    "portable": {
      "artifactName": "RestaurantPOS-win-${arch}-portable.${ext}"
    }
  }
}
