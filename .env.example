# Development-only overrides. The production service always binds to 127.0.0.1.
PORT=3000
VITE_DEV_SERVER_PORT=5173
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
# Must be an absolute, writable path. Leave unset for the OS-specific user data directory.
# POS_DATA_DIR=/absolute/path/to/restaurant-pos-data
# Set to true only after HTTPS termination is configured locally.
COOKIE_SECURE=false
# Optional absolute path, preferably on another physical drive. When set, this
# has priority over the locally saved admin setting and disables UI changes.
# POS_BACKUP_DIR=/absolute/path/to/restaurant-pos-backups
# Automatic daily backup retention; valid range is 7–365 days (default 30).
POS_BACKUP_RETENTION_DAYS=30
